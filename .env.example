# Directory for the SQLite database and private media files.
BLOOM_DATA_DIR=.data

# Set to 1 when Bloom is behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0

# Rate limiting is on unless this is exactly "off" (tests and local e2e only).
BLOOM_RATE_LIMIT=on

# Secure cookies default to on when NODE_ENV=production.
# COOKIE_SECURE=0

# Optional Web Push. If any value is missing, push is disabled.
# In-app delivery still works. Generate keys with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
